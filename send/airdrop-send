#!/usr/bin/env python3
"""Fenêtre d'envoi AirDrop (GTK 4 + libadwaita), par-dessus Owly.

    airdrop-send FICHIER...     envoyer des fichiers
    airdrop-send --url URL      envoyer un lien

La radio n'est tenue que le temps de la fenêtre : `owly radio up --for` la
rend de toute façon, et owlyd la reprend si ce processus disparaît.
"""

import ipaddress
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

import discover  # noqa: E402

APP_ID = "fr.portalstudio.AirDropSend"
ICON = "network-wireless-hotspot-symbolic"
# Plafond de la radio : au-delà, owly la rend même si la fenêtre est restée.
RADIO_SECONDS = 300
DISCOVER_EVERY = 3
# Un appareil que la radio n'entend plus depuis ce délai sort de la liste.
FORGET_SECONDS = 15
CLOSE_AFTER_SENT = 2


def unquote(s):
    """Une chaîne {:?} de Rust, telle qu'owly l'écrit."""
    s = s.strip()
    if not (s.startswith('"') and s.endswith('"')):
        return s
    s = re.sub(r"\\u\{([0-9a-fA-F]+)\}", lambda m: chr(int(m.group(1), 16)), s)
    try:
        return json.loads(s)
    except ValueError:
        return s[1:-1]


def mac_from_link_local(addr):
    """Le MAC d'une adresse EUI-64 modifiée (l'inverse de discover.link_local)."""
    b = ipaddress.IPv6Address(addr).packed[8:]
    if b[3:5] != b"\xff\xfe":
        return None
    return ":".join(f"{x:02x}" for x in (b[0] ^ 0x02, b[1], b[2], b[5], b[6], b[7]))


def proximity(rssi):
    if rssi is None:
        return "À proximité"
    if rssi > -50:
        return "Très proche"
    if rssi > -65:
        return "Proche"
    return "Plus loin"


def summary(files, urls):
    if urls:
        return urls[0] if len(urls) == 1 else f"{len(urls)} liens"
    if len(files) == 1:
        return os.path.basename(files[0])
    size = sum(os.path.getsize(f) for f in files if os.path.isfile(f))
    return f"{len(files)} fichiers · {GLib.format_size(size)}"


class Radio:
    """`owly radio up` tant que la fenêtre vit, et l'écoute des appareils."""

    def __init__(self, on_up, on_failed, on_device):
        self._on_up, self._on_failed, self._on_device = on_up, on_failed, on_device
        self._procs = []
        self._stop = threading.Event()

    def start(self):
        threading.Thread(target=self._run, daemon=True).start()

    def _spawn(self, args, **kw):
        kw.setdefault("text", True)
        p = subprocess.Popen(args, **kw)
        self._procs.append(p)
        return p

    def _run(self):
        try:
            radio = self._spawn(["owly", "radio", "up", "--for", str(RADIO_SECONDS)],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        except OSError as e:
            GLib.idle_add(self._on_failed, f"owly introuvable : {e}")
            return
        last = ""
        for line in radio.stdout:
            if line.startswith("awdl0 is up"):
                break
            last = line.strip() or last
        else:
            if not self._stop.is_set():
                GLib.idle_add(self._on_failed, last or "la radio AirDrop n'a pas démarré")
            return
        # Le reste de la sortie (la liste des pairs, chaque seconde) n'intéresse
        # personne, mais il faut vider le tuyau.
        threading.Thread(target=lambda: [None for _ in radio.stdout], daemon=True).start()
        GLib.idle_add(self._on_up)
        threading.Thread(target=self._browse, daemon=True).start()
        self._discover_loop()

    # `owly browse` réveille les iPhone en Bluetooth (BLE-1) et liste ceux
    # qui s'annoncent en mDNS.
    def _browse(self):
        browse = self._spawn(["owly", "browse", "--seconds", str(RADIO_SECONDS)],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        pattern = re.compile(r'^\S+\s+(".*") \(\[([0-9a-fA-F:]+)%\d+\]:\d+\)$')
        for line in browse.stdout:
            m = pattern.match(line.strip())
            mac = m and mac_from_link_local(m.group(2))
            if mac:
                GLib.idle_add(self._on_device, mac, {"name": unquote(m.group(1))})

    # Les autres, comme un iPhone qui ne s'annonce pas : on leur demande
    # leur nom (POST /Discover), sans rien envoyer.
    def _discover_loop(self):
        with ThreadPoolExecutor(max_workers=6) as pool:
            while not self._stop.wait(DISCOVER_EVERY):
                try:
                    peers = discover.peers()
                except GLib.Error:
                    continue
                for peer, found in zip(peers, pool.map(self._ask, peers)):
                    GLib.idle_add(self._on_device, peer["mac"], {"rssi": peer.get("rssi"), **found})

    @staticmethod
    def _ask(peer):
        try:
            return discover.discover(peer["mac"]) or {}
        except Exception:  # noqa: BLE001 : un pair qui ne répond pas, c'est normal
            return {}

    def send(self, mac, files, urls, on_event):
        """Envoie dans un thread ; on_event(kind, *args) dans la boucle GTK."""
        args = ["owly", "send", "--mac", mac]
        args += [a for u in urls for a in ("--url", u)] or files
        threading.Thread(target=self._send_guarded, args=(args, on_event), daemon=True).start()

    # Quoi qu'il arrive, la fenêtre doit sortir de « En attente… ».
    def _send_guarded(self, args, on_event):
        try:
            self._send(args, on_event)
        except Exception as e:  # noqa: BLE001
            GLib.idle_add(on_event, "failed", f"{type(e).__name__}: {e}")

    def _send(self, args, on_event):
        p = self._spawn(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0, text=False)

        def stderr():
            # La progression se réécrit avec \r : on coupe sur \r et \n.
            buf = b""
            while chunk := p.stderr.read(256):
                buf += chunk
                *parts, buf = re.split(rb"[\r\n]", buf)
                for part in parts:
                    line = part.decode(errors="replace")
                    if line == "accepted":
                        GLib.idle_add(on_event, "accepted")
                    elif m := re.match(r"^(\d+) / (\d+) bytes$", line):
                        GLib.idle_add(on_event, "progress", int(m[1]), int(m[2]))
                    elif line.startswith("owly: "):
                        GLib.idle_add(on_event, "failed", line[6:])

        t = threading.Thread(target=stderr, daemon=True)
        t.start()
        out = p.stdout.read().decode(errors="replace").strip()
        p.wait()
        t.join(timeout=1)
        if out == "delivered":
            GLib.idle_add(on_event, "delivered")
        elif out == "declined":
            GLib.idle_add(on_event, "declined")
        elif out.startswith("failed: "):
            GLib.idle_add(on_event, "failed", out[8:])
        elif p.returncode != 0:
            GLib.idle_add(on_event, "failed", out or f"owly send a quitté ({p.returncode})")

    # Ctrl-C partout : owly rend la radio proprement.
    def stop(self):
        self._stop.set()
        for p in reversed(self._procs):
            if p.poll() is None:
                p.send_signal(signal.SIGINT)
        deadline = time.monotonic() + 3
        for p in self._procs:
            try:
                p.wait(timeout=max(0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                p.kill()


class DeviceRow(Adw.ActionRow):
    def __init__(self, mac, on_activate):
        super().__init__(activatable=True)
        self.mac = mac
        self.name = None
        self.rssi = None
        self.seen = time.monotonic()
        self._icon = Gtk.Image(icon_name="phone-symbolic", pixel_size=32)
        self.add_prefix(self._icon)
        self.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self.connect("activated", lambda _row: on_activate(self))

    def update(self, info):
        self.seen = time.monotonic()
        if info.get("name"):
            self.name = info["name"]
        if info.get("rssi") is not None:
            self.rssi = info["rssi"]
        model = (info.get("model") or self.name or "").lower()
        if "mac" in model:
            self._icon.set_from_icon_name("computer-symbolic")
        self.set_title(GLib.markup_escape_text(self.name or ""))
        self.set_subtitle(proximity(self.rssi))


class SendWindow(Adw.ApplicationWindow):
    def __init__(self, app, files, urls):
        super().__init__(application=app, title="AirDrop", default_width=420, default_height=520)
        self.files, self.urls = files, urls
        self.rows = {}
        self.sending = False

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="AirDrop", subtitle=summary(files, urls)))
        self.banner = Adw.Banner(
            title="Le Wi-Fi est coupé le temps de l'envoi, puis rétabli.", revealed=True)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._status("Démarrage de la radio AirDrop…", spinner=True), "starting")

        self.group = Adw.PreferencesGroup(
            title="Appareils à proximité",
            description="Sur l'iPhone : AirDrop en « Tout le monde », écran déverrouillé.")
        self.group.set_header_suffix(Adw.Spinner())
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        self.list.set_placeholder(Gtk.Label(label="Recherche des appareils…", margin_top=18,
                                            margin_bottom=18, css_classes=["dim-label"]))
        self.group.add(self.list)
        page = Adw.PreferencesPage()
        page.add(self.group)
        self.stack.add_named(page, "list")

        self.progress = Gtk.ProgressBar(show_text=True, margin_start=48, margin_end=48)
        self.sending_page = self._status("", spinner=True, child=self.progress)
        self.stack.add_named(self.sending_page, "sending")

        self.result_page = self._status("", child=Gtk.Button(
            label="Fermer", halign=Gtk.Align.CENTER, css_classes=["pill", "suggested-action"]))
        self.result_page.get_child().connect("clicked", lambda _b: self.close())
        self.stack.add_named(self.result_page, "result")

        view = Adw.ToolbarView(content=self.stack)
        view.add_top_bar(header)
        view.add_top_bar(self.banner)
        self.set_content(view)

        self.radio = Radio(self._on_up, self._on_failed, self._on_device)
        self.connect("close-request", self._on_close)
        GLib.timeout_add_seconds(DISCOVER_EVERY, self._prune)
        self.radio.start()

    @staticmethod
    def _status(title, spinner=False, child=None):
        page = Adw.StatusPage(title=title)
        if spinner:
            page.set_paintable(Adw.SpinnerPaintable.new(page))
        if child:
            page.set_child(child)
        return page

    def _on_up(self):
        self.stack.set_visible_child_name("list")

    def _on_failed(self, reason):
        if self.sending:
            return
        self._show_result("Impossible de démarrer AirDrop", reason, "dialog-error-symbolic")

    def _on_device(self, mac, info):
        row = self.rows.get(mac)
        if row is None:
            if not info.get("name"):
                return  # n'apparaît que celui qui accepte et a donné son nom
            row = DeviceRow(mac, self._on_pick)
            self.rows[mac] = row
            self.list.append(row)
        row.update(info)

    def _prune(self):
        now = time.monotonic()
        for mac, row in list(self.rows.items()):
            if now - row.seen > FORGET_SECONDS:
                self.list.remove(row)
                del self.rows[mac]
        return GLib.SOURCE_CONTINUE

    def _on_pick(self, row):
        if self.sending:
            return
        self.sending = True
        self.target = row.name
        self.sending_page.set_title(f"Envoi à {row.name}")
        self.sending_page.set_description("En attente d'acceptation sur l'appareil…")
        self.progress.set_visible(False)
        self.stack.set_visible_child_name("sending")
        self.radio.send(row.mac, self.files, self.urls, self._on_send_event)

    def _on_send_event(self, kind, *args):
        if kind == "accepted":
            self.sending_page.set_description("Envoi en cours…")
        elif kind == "progress":
            sent, total = args
            self.progress.set_visible(True)
            self.progress.set_fraction(sent / total if total else 1)
            self.progress.set_text(f"{GLib.format_size(sent)} / {GLib.format_size(total)}")
        elif kind == "delivered":
            self._show_result("Envoyé", f"Reçu par {self.target}.", "object-select-symbolic")
            GLib.timeout_add_seconds(CLOSE_AFTER_SENT, self.close)
        elif kind == "declined":
            self._show_result("Refusé", f"{self.target} a refusé.", "action-unavailable-symbolic")
        elif kind == "failed":
            self._show_result("Échec de l'envoi", args[0], "dialog-error-symbolic")

    def _show_result(self, title, description, icon):
        self.result_page.set_title(title)
        self.result_page.set_description(GLib.markup_escape_text(description))
        self.result_page.set_icon_name(icon)
        self.stack.set_visible_child_name("result")
        # Fini : on rend le Wi-Fi tout de suite, sans attendre la fermeture.
        threading.Thread(target=self.radio.stop, daemon=True).start()
        self.banner.set_title("Wi-Fi rétabli.")

    def _on_close(self, _window):
        self.radio.stop()
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.NON_UNIQUE | Gio.ApplicationFlags.HANDLES_OPEN)
        self.add_main_option("url", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING_ARRAY,
                             "Envoyer un lien au lieu de fichiers", "URL")
        self.urls = []
        self.connect("handle-local-options", self._options)

    def _options(self, _app, options):
        urls = options.lookup_value("url", GLib.VariantType("as"))
        self.urls = urls.unpack() if urls else []
        return -1

    def do_open(self, files, _n, _hint):
        paths = [f.get_path() for f in files if f.get_path() and os.path.isfile(f.get_path())]
        if paths:
            SendWindow(self, paths, []).present()

    def do_activate(self):
        if self.urls:
            SendWindow(self, [], self.urls).present()
            return
        dialog = Gtk.FileDialog(title="Envoyer via AirDrop")
        dialog.open_multiple(None, None, self._picked)
        self.hold()

    def _picked(self, dialog, result):
        self.release()
        try:
            files = dialog.open_multiple_finish(result)
        except GLib.Error:
            return
        self.do_open([files.get_item(i) for i in range(files.get_n_items())], 0, "")


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
