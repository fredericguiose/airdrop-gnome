{
  "manifest_version": 3,
  "name": "AirDrop (Linux)",
  "description": "Envoyer la page ou un lien à un iPhone ou un Mac par AirDrop, via airdrop-gnome.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Envoyer cette page via AirDrop",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}
  },
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}
