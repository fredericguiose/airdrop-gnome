From 02b6c9a1ef87e55f2ccf90739e5dbcab55390cc7 Mon Sep 17 00:00:00 2001
From: Shae Wilde <shaecodes@gmail.com>
Date: Wed, 14 Oct 2026 15:01:00 -0300
Subject: [PATCH] wifi: mt76: mt7921: honor injected legacy rates on MT7922

MT7922 monitor-injected unicast frames do not honor the legacy rate
requested through radiotap. They use the default 1 Mbps CCK descriptor,
which makes 2.4 GHz AirDrop transfers unreliable and prevents injected
unicast from reaching the air on 5 GHz in the reported failure.

mt76_tx_status_skb_add() clears status_driver_data, which overlaps
info->control.flags. Checking RATE_INJECT only in the common descriptor
builder is therefore too late for the PCI transmit path.

Save the requested legacy hardware rate before status bookkeeping. Use
the common builder's fixed-rate path so that its complete descriptor
setup, including antenna/SPE selection, is retained. Restore the original
USE_MINRATE flag and replace only the descriptor's rate field afterwards.

Limit the change to MT7922 injected legacy rates, validating the band and
rate index and leaving HT/VHT requests and hardware encapsulation alone.

Fixes: 688088728bd3 ("mt76: mt7921: Add mt7922 support")
Link: https://github.com/t4t5/omdrop-owl/issues/14#issuecomment-6127187359
Link: https://github.com/t4t5/omdrop-owl/issues/14#issuecomment-6155974576
Assisted-by: LLM
---
 mt7921/pci_mac.c | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/mt7921/pci_mac.c b/mt7921/pci_mac.c
index d5c33a0d4..5fb9a28c2 100644
--- a/mt7921/pci_mac.c
+++ b/mt7921/pci_mac.c
@@ -15,6 +15,9 @@ int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	struct ieee80211_key_conf *key = info->control.hw_key;
 	struct mt76_connac_hw_txp *txp;
 	struct mt76_txwi_cache *t;
+	bool use_minrate = info->flags & IEEE80211_TX_CTL_USE_MINRATE;
+	bool injected_legacy = false;
+	u16 injected_rate = 0;
 	int id, pid;
 	u8 *txwi = (u8 *)txwi_ptr;
 
@@ -40,10 +43,46 @@ int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 		}
 	}
 
+	/* Save the rate before TX status bookkeeping clears control.flags. */
+	if (is_mt7922(mdev) &&
+	    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+	    (info->flags & IEEE80211_TX_CTL_INJECTED) &&
+	    (info->control.flags & IEEE80211_TX_CTRL_RATE_INJECT) &&
+	    !(info->control.rates[0].flags &
+	      (IEEE80211_TX_RC_MCS | IEEE80211_TX_RC_VHT_MCS)) &&
+	    info->band < NUM_NL80211_BANDS) {
+		struct ieee80211_supported_band *sband;
+		int idx = info->control.rates[0].idx;
+
+		sband = mdev->phy.hw->wiphy->bands[info->band];
+		if (sband && idx >= 0 && idx < sband->n_bitrates) {
+			struct ieee80211_rate *r = &sband->bitrates[idx];
+			u16 hw_rate = r->hw_value;
+
+			if (info->control.rates[0].flags & IEEE80211_TX_RC_USE_SHORT_PREAMBLE)
+				hw_rate = r->hw_value_short;
+			injected_rate = FIELD_PREP(MT_TX_RATE_MODE, hw_rate >> 8) |
+					FIELD_PREP(MT_TX_RATE_IDX, hw_rate & 0xff);
+			injected_legacy = true;
+		}
+	}
+
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+	/* Let the common builder apply all fixed-rate descriptor settings. */
+	if (injected_legacy)
+		info->flags |= IEEE80211_TX_CTL_USE_MINRATE;
 	mt76_connac2_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, key,
 				    pid, qid, 0);
 
+	if (injected_legacy) {
+		__le32 *txd = txwi_ptr;
+
+		if (!use_minrate)
+			info->flags &= ~IEEE80211_TX_CTL_USE_MINRATE;
+		txd[6] &= ~cpu_to_le32(MT_TXD6_TX_RATE);
+		txd[6] |= cpu_to_le32(FIELD_PREP(MT_TXD6_TX_RATE, injected_rate));
+	}
+
 	txp = (struct mt76_connac_hw_txp *)(txwi + MT_TXD_SIZE);
 	memset(txp, 0, sizeof(struct mt76_connac_hw_txp));
 	mt76_connac_write_hw_txp(mdev, tx_info, txp, id);
