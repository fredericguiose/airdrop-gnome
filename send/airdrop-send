#!/usr/bin/env python3
"""Fenêtre d'envoi AirDrop (GTK 4 + libadwaita), cliente d'airdropd.

    airdrop-send FICHIER...     envoyer des fichiers
    airdrop-send --url URL      envoyer un lien
    airdrop-send                choisir des fichiers

La radio, la recherche des appareils et l'envoi sont l'affaire d'airdropd
(D-Bus, session) : la fenêtre ne fait que demander et afficher. Si elle
disparaît, airdropd arrête de chercher pour elle de lui-même.
"""

import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "fr.portalstudio.AirDropSend"
BUS_NAME = "fr.portalstudio.AirDrop"
PATH = "/fr/portalstudio/AirDrop"
IFACE = "fr.portalstudio.AirDrop1"
CLOSE_AFTER_SENT = 2


def proximity(rssi):
    if not rssi:
        return "À proximité"
    if rssi > -50:
        return "Très proche"
    if rssi > -65:
        return "Proche"
    return "Plus loin"


def summary(files, urls):
    if urls:
        return urls[0] if len(urls) == 1 else f"{len(urls)} liens"
    if len(files) == 1:
        return os.path.basename(files[0])
    size = sum(os.path.getsize(f) for f in files if os.path.isfile(f))
    return f"{len(files)} fichiers · {GLib.format_size(size)}"


class AirDrop:
    """Le bout d'airdropd dont la fenêtre a besoin."""

    def __init__(self, on_radio, on_failed, on_device, on_lost):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self._on = {"radio": on_radio, "failed": on_failed, "device": on_device, "lost": on_lost}
        self._transfers = {}
        self.bus.signal_subscribe(BUS_NAME, IFACE, None, PATH, None, Gio.DBusSignalFlags.NONE, self._signal)
        self.bus.signal_subscribe(BUS_NAME, "org.freedesktop.DBus.Properties", "PropertiesChanged", PATH,
                                  IFACE, Gio.DBusSignalFlags.MATCH_ARG0_NAMESPACE, self._props)

    def _call(self, method, args=None, reply=None, on_reply=None):
        def done(bus, res):
            try:
                result = bus.call_finish(res).unpack()
            except GLib.Error as e:
                self._on["failed"](Gio.DBusError.strip_remote_error(e) or e.message)
                return
            if on_reply:
                on_reply(*result)
        self.bus.call(BUS_NAME, PATH, IFACE, method, args, GLib.VariantType(reply) if reply else None,
                      Gio.DBusCallFlags.NONE, 10_000, None, done)

    def start(self):
        # Le premier appel lance airdropd (activation D-Bus).
        self._call("StartBrowsing", on_reply=lambda: (self._read_radio(), self._read_devices()))

    def _read_radio(self):
        self.bus.call(BUS_NAME, PATH, "org.freedesktop.DBus.Properties", "Get",
                      GLib.Variant("(ss)", (IFACE, "Radio")), GLib.VariantType("(v)"),
                      Gio.DBusCallFlags.NONE, -1, None,
                      lambda bus, res: self._on["radio"](bus.call_finish(res).unpack()[0]))

    def _read_devices(self):
        self._call("GetDevices", reply="(aa{sv})", on_reply=lambda devices: [
            self._on["device"](d["mac"], d) for d in devices])

    def send(self, mac, files, urls, on_event):
        def started(transfer):
            self._transfers[transfer] = on_event
        self._call("Send", GLib.Variant("(sasas)", (mac, files, urls)), "(s)", started)

    def stop(self):
        try:
            self.bus.call_sync(BUS_NAME, PATH, IFACE, "StopBrowsing", None, None,
                               Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        except GLib.Error:
            pass

    def _props(self, _c, _s, _p, _i, _n, params):
        _iface, changed, _ = params.unpack()
        if "Radio" in changed:
            self._on["radio"](changed["Radio"])

    def _signal(self, _c, _s, _p, _i, name, params):
        args = params.unpack()
        if name == "DeviceSeen":
            mac, dev_name, model, rssi = args
            self._on["device"](mac, {"name": dev_name, "model": model, "rssi": rssi})
        elif name == "DeviceLost":
            self._on["lost"](args[0])
        elif name == "RadioFailed":
            self._on["failed"](args[0])
        elif name == "SendProgress":
            transfer, state, sent, total, detail = args
            if on_event := self._transfers.get(transfer):
                on_event(state, sent, total, detail)


class DeviceRow(Adw.ActionRow):
    def __init__(self, mac, on_activate):
        super().__init__(activatable=True)
        self.mac = mac
        self.name = ""
        self._icon = Gtk.Image(icon_name="phone-symbolic", pixel_size=32)
        self.add_prefix(self._icon)
        self.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self.connect("activated", lambda _row: on_activate(self))

    def update(self, info):
        self.name = info.get("name") or self.name
        if "mac" in (info.get("model") or self.name).lower():
            self._icon.set_from_icon_name("computer-symbolic")
        self.set_title(GLib.markup_escape_text(self.name))
        self.set_subtitle(proximity(info.get("rssi")))


class SendWindow(Adw.ApplicationWindow):
    def __init__(self, app, files, urls):
        super().__init__(application=app, title="AirDrop", default_width=420, default_height=520)
        self.files, self.urls = files, urls
        self.rows = {}
        self.sending = False
        self.done = False

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="AirDrop", subtitle=summary(files, urls)))
        self.banner = Adw.Banner(
            title="Le Wi-Fi est coupé le temps de l'envoi, puis rétabli.", revealed=True)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._status("Démarrage de la radio AirDrop…", spinner=True), "starting")

        self.group = Adw.PreferencesGroup(
            title="Appareils à proximité",
            description="Sur l'iPhone : AirDrop en « Tout le monde », écran déverrouillé.")
        self.group.set_header_suffix(Adw.Spinner())
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        self.list.set_placeholder(Gtk.Label(label="Recherche des appareils…", margin_top=18,
                                            margin_bottom=18, css_classes=["dim-label"]))
        self.group.add(self.list)
        page = Adw.PreferencesPage()
        page.add(self.group)
        self.stack.add_named(page, "list")

        self.progress = Gtk.ProgressBar(show_text=True, margin_start=48, margin_end=48)
        self.sending_page = self._status("", spinner=True, child=self.progress)
        self.stack.add_named(self.sending_page, "sending")

        self.result_page = self._status("", child=Gtk.Button(
            label="Fermer", halign=Gtk.Align.CENTER, css_classes=["pill", "suggested-action"]))
        self.result_page.get_child().connect("clicked", lambda _b: self.close())
        self.stack.add_named(self.result_page, "result")

        view = Adw.ToolbarView(content=self.stack)
        view.add_top_bar(header)
        view.add_top_bar(self.banner)
        self.set_content(view)

        self.airdrop = AirDrop(self._on_radio, self._on_failed, self._on_device, self._on_lost)
        self.connect("close-request", lambda _w: self.airdrop.stop() or False)
        self.airdrop.start()

    @staticmethod
    def _status(title, spinner=False, child=None):
        page = Adw.StatusPage(title=title)
        if spinner:
            page.set_paintable(Adw.SpinnerPaintable.new(page))
        if child:
            page.set_child(child)
        return page

    def _on_radio(self, state):
        if state == "up" and self.stack.get_visible_child_name() == "starting":
            self.stack.set_visible_child_name("list")
        elif state == "idle" and self.done:
            self.banner.set_title("Wi-Fi rétabli.")

    def _on_failed(self, reason):
        if not self.done:
            self._show_result("Impossible de démarrer AirDrop", reason, "dialog-error-symbolic")

    def _on_device(self, mac, info):
        if self.done:
            return
        if self.stack.get_visible_child_name() == "starting":
            self.stack.set_visible_child_name("list")
        row = self.rows.get(mac)
        if row is None:
            row = self.rows[mac] = DeviceRow(mac, self._on_pick)
            self.list.append(row)
        row.update(info)

    def _on_lost(self, mac):
        if row := self.rows.pop(mac, None):
            self.list.remove(row)

    def _on_pick(self, row):
        if self.sending:
            return
        self.sending = True
        self.target = row.name
        self.sending_page.set_title(f"Envoi à {row.name}")
        self.sending_page.set_description("En attente d'acceptation sur l'appareil…")
        self.progress.set_visible(False)
        self.stack.set_visible_child_name("sending")
        self.airdrop.send(row.mac, self.files, self.urls, self._on_send_event)

    def _on_send_event(self, state, sent, total, detail):
        if state == "accepted":
            self.sending_page.set_description("Envoi en cours…")
        elif state == "progress":
            self.sending_page.set_description("Envoi en cours…")
            self.progress.set_visible(True)
            self.progress.set_fraction(sent / total if total else 1)
            self.progress.set_text(f"{GLib.format_size(sent)} / {GLib.format_size(total)}")
        elif state == "delivered":
            self._show_result("Envoyé", f"Reçu par {self.target}.", "object-select-symbolic")
            GLib.timeout_add_seconds(CLOSE_AFTER_SENT, self.close)
        elif state == "declined":
            self._show_result("Refusé", f"{self.target} a refusé.", "action-unavailable-symbolic")
        elif state == "failed":
            self._show_result("Échec de l'envoi", detail, "dialog-error-symbolic")

    def _show_result(self, title, description, icon):
        self.done = True
        self.result_page.set_title(title)
        self.result_page.set_description(GLib.markup_escape_text(description))
        self.result_page.set_icon_name(icon)
        self.stack.set_visible_child_name("result")
        # Fini : airdropd rend la radio, sauf si une réception la tient encore.
        self.airdrop.stop()


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.NON_UNIQUE | Gio.ApplicationFlags.HANDLES_OPEN)
        self.add_main_option("url", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING_ARRAY,
                             "Envoyer un lien au lieu de fichiers", "URL")
        self.urls = []
        self.connect("handle-local-options", self._options)

    def _options(self, _app, options):
        urls = options.lookup_value("url", GLib.VariantType("as"))
        self.urls = urls.unpack() if urls else []
        return -1

    def do_open(self, files, _n, _hint):
        paths = [f.get_path() for f in files if f.get_path() and os.path.isfile(f.get_path())]
        if paths:
            SendWindow(self, paths, []).present()

    def do_activate(self):
        if self.urls:
            SendWindow(self, [], self.urls).present()
            return
        dialog = Gtk.FileDialog(title="Envoyer via AirDrop")
        dialog.open_multiple(None, None, self._picked)
        self.hold()

    def _picked(self, dialog, result):
        self.release()
        try:
            files = dialog.open_multiple_finish(result)
        except GLib.Error:
            return
        self.do_open([files.get_item(i) for i in range(files.get_n_items())], 0, "")


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
